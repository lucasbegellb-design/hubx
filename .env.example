# ---------------------------------------------------------------------------
# Hub XTIM — variables d'environnement
# Copier en `.env` (jamais commité). Voir SETUP.md pour chaque valeur.
# ---------------------------------------------------------------------------

# Front (intégrées au build, seules valeurs présentes dans l'app) -----------
# Adresse du projet Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
# Clé publique « anon » / « publishable » (jamais la clé service_role !)
VITE_SUPABASE_ANON_KEY=REMPLACER

# Pour relier la CLI au projet distant (supabase link / db push)
SUPABASE_PROJECT_REF=REMPLACER
SUPABASE_DB_PASSWORD=REMPLACER

# ---------------------------------------------------------------------------
# Secrets des Edge Functions (à définir avec `npx supabase secrets set ...`,
# JAMAIS dans l'app). Listés ici pour mémoire / pour `supabase functions serve --env-file`.
# ---------------------------------------------------------------------------
# Clé API Anthropic (analyse de documents, structuration de process, synthèse des rapports)
ANTHROPIC_API_KEY=
# Secret partagé entre pg_cron et les fonctions (chaîne aléatoire longue)
CRON_SECRET=
# Application Azure (Microsoft Graph, permission application Files.Read.All + consentement admin)
# Tant qu'elles sont vides, le Suivi Chine fonctionne en mode démo (fichier d'exemple).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
